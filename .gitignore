# Build artifacts live in build/ (which has its own .gitignore keeping the dir)
/ads
/build/ads

# Local credentials & state — never commit
*.local.toml
/.ads/
credentials.json

# OS / editor cruft
.DS_Store
*.swp

# `go build ./...` drops a binary named after the module here
/goads

# Diff scaffolding written by the automated PR review workflows
.review-scope/
